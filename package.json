{
  "name": "igmg-ikra",
  "productName": "IGMG Ikra",
  "version": "0.1.0",
  "description": "IGMG İkra – offline lesapp voor docenten en leerlingen",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "make:demo": "python3 scripts/make-demo-assets.py",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "make:icon": "python3 scripts/make-icon.py"
  },
  "devDependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@playwright/test": "1.56",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "author": "IGMG",
  "build": {
    "appId": "org.igmg.ikra",
    "productName": "IGMG Ikra",
    "executableName": "igmg-ikra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "IGMG-Ikra-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IGMG İkra",
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "nl_NL",
        "tr_TR",
        "de_DE"
      ],
      "language": "1043"
    },
    "copyright": "IGMG"
  },
  "desktopName": "igmg-ikra.desktop"
}
